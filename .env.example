# PostgreSQL (Docker Compose defaults)
DATABASE_URL="postgresql://smartev:smartev_dev@localhost:5432/smartev?schema=public"
POSTGRES_USER=smartev
POSTGRES_PASSWORD=smartev_dev
POSTGRES_DB=smartev

# API security — replace in every non-demo environment
JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_EXPIRES_IN="1d"
BCRYPT_ROUNDS=12
CORS_ORIGIN="http://localhost:3000"
PORT=4000

# Planning configuration
MIN_RESERVE_SOC=10
DEFAULT_TARGET_SOC=80
CHARGING_EFFICIENCY=0.90
MAX_STATION_CORRIDOR_KM=10
ROUTE_ENERGY_BUFFER=1.05
PROVIDER_TIMEOUT_MS=4500

# Provider URLs. API keys stay in the backend only.
OSRM_BASE_URL="https://router.project-osrm.org"
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
OPEN_CHARGE_MAP_BASE_URL="https://api.openchargemap.io/v3"
OPEN_CHARGE_MAP_API_KEY=""

NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_DEMO_MODE=true

